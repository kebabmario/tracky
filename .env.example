# Copy to .env and start with `node --env-file=.env server.js`. All values are optional locally.

# HTTP port for `npm start`.
PORT=3000

# Shared secret required by POST /api/capture and POST /api/refresh.
# Leave empty locally to allow writes without a key. Required on Vercel.
CAPTURE_KEY=

# Bearer token expected by GET /api/cron (Vercel Cron sends it automatically).
CRON_SECRET=

# Set by Vercel when a Blob store is connected. Switches storage from data/prices.json to Vercel Blob.
BLOB_READ_WRITE_TOKEN=
